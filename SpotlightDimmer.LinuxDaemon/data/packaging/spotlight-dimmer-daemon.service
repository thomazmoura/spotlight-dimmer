# SpotlightDimmer daemon - systemd user unit (.deb packaging variant)
# Shipped by the spotlight-dimmer-gnome/-kde packages to /usr/lib/systemd/user/.
# Keep in sync with ../spotlight-dimmer-daemon.service (the per-user
# `make install-daemon` variant); the only difference is the ExecStart path.
# Normally started on demand via D-Bus activation (see
# org.spotlightdimmer.Daemon.service); this unit provides restart-on-crash
# and clean lifecycle binding to the graphical session.

[Unit]
Description=SpotlightDimmer overlay daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.spotlightdimmer.Daemon
ExecStart=/usr/bin/spotlight-dimmer-daemon
Restart=on-failure
RestartSec=1
Slice=background.slice

[Install]
WantedBy=graphical-session.target
