# SpotlightDimmer daemon - systemd user unit
# Installed to ~/.config/systemd/user/ by `make install-daemon`.
# Normally started on demand via D-Bus activation (see
# org.spotlightdimmer.Daemon.service); this unit provides restart-on-crash
# and clean lifecycle binding to the graphical session.

[Unit]
Description=SpotlightDimmer overlay daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.spotlightdimmer.Daemon
ExecStart=%h/.local/bin/spotlight-dimmer-daemon
Restart=on-failure
RestartSec=1
Slice=background.slice

[Install]
WantedBy=graphical-session.target
